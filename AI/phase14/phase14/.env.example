# KarigarSaathi AI Phase 14 - Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=/api/v1
LOG_LEVEL=INFO

# Database (SQLite for standalone development)
DATABASE_URL=sqlite+aiosqlite:///./data/db.sqlite

# JWT (development defaults - CHANGE IN PRODUCTION)
JWT_SECRET=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# Consent
CONSENT_POLICY_VERSION=v1

# Recording retention
RECORDING_RETENTION_MODE=configurable
RECORDING_RETENTION_DAYS=30
TRANSCRIPT_RETENTION_DAYS=90

# Whisper (Faster Whisper configuration)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
LOW_CONFIDENCE_THRESHOLD=0.5
BEAM_SIZE=5

# LLM (OpenAI-compatible endpoint)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=dev-key
LLM_MODEL=nemotron
LLM_TIMEOUT_SECONDS=60

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Audio
MAX_AUDIO_SIZE_MB=50
MAX_AUDIO_DURATION_SECONDS=300
ALLOWED_AUDIO_FORMATS=wav,mp3,m4a,webm,ogg

# Feature flags
ENABLE_PROCESSING=true

# Private upload directory
PRIVATE_UPLOAD_DIR=./private/uploads