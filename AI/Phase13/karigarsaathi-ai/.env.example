# KarigarSaathi AI Image Studio - Environment Configuration
# Copy this to .env and fill in real values for production

# Application
APP_NAME=KarigarSaathi AI Image Studio
APP_ENV=development
APP_DEBUG=True
APP_VERSION=0.1.0

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Security - Development token (use strong random value)
# NEVER commit real secrets to source control
DEVELOPMENT_BEARER_TOKEN=your-dev-token-here
# For production, configure Firebase Admin SDK instead

# File storage
ORIGINALS_DIR=storage/originals
ENHANCED_DIR=storage/enhanced
PREVIEWS_DIR=storage/previews
MAX_UPLOAD_SIZE=10485760  # 10 MB in bytes

# Media Storage Provider (cloudinary | firebase_emulator | local)
MEDIA_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Image validation
MIN_DIMENSION=256
MAX_DIMENSION=6000
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Quota defaults
DEFAULT_JOBS_PER_ARTISAN_PER_DAY=20
MAX_PROCESSING_TIME_SECONDS=60

# CORS (for website integration)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Logging
LOG_LEVEL=INFO