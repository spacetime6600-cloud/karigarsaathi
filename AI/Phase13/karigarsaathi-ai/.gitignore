# KarigarSaathi AI Image Studio - Microservice .gitignore

# Environment
.env
*.env*
!*.env.example

# Local storage (replaced by cloud/storage in production)
/storage/uploads/
/storage/outputs/
/storage/jobs/

# Cache and runtime
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
htmlcov/
.venv/
env/
venv/

# Model weights (large weights ignored, but lightweight 4.5MB u2netp is tracked for fast offline inference)
models/*.onnx
!models/u2netp.onnx
models/*.bin
models/*.pt
~/.cache/rembg/

# Generated reports
/evaluation/report.csv
/evaluation/evaluation_report.json