# ==============================================================================
# KarigarSaathi Frontend Environment Configuration (.env.example)
# For local development: copy to .env or .env.local
# For Vercel production: configure in Vercel Project Settings -> Environment Variables
# ==============================================================================

# Application
VITE_APP_TITLE=KarigarSaathi
VITE_APP_ENV=production

# Production Firebase Web Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Disable local emulators in production (set to false for production)
VITE_USE_FIREBASE_EMULATORS=false

# AI Image Studio Microservice (:8000 on local, Render URL on production)
VITE_AI_ENABLED=true
VITE_AI_SERVICE_URL=https://karigarsaathi-ai-image.onrender.com

# AI Voice & Auto-Catalogue Microservice (:8001 on local, Render URL on production)
VITE_VOICE_CATALOGUE_ENABLED=true
VITE_VOICE_CATALOGUE_SERVICE_URL=https://karigarsaathi-ai-voice.onrender.com
