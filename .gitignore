# =========================================================
# KarigarSaathi — Project Root .gitignore
# =========================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs
dist/
dist-ssr/
build/
out/
*.tsbuildinfo

# Test, Automation & Coverage
coverage/
.nyc_output/
playwright-report/
test-results/
.temp_edge_profile*/

# Environment Files (Keep .env.example tracked)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example

# Service Account Keys & Secrets
*service-account*.json
*credentials*.json
*.pem
*.key
*.p12
*.pkcs12

# Editor & IDE Directories
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Logs & Temporary Files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tmp
*.temp
*.bak

# Firebase Local & Debug Files
.firebase/
firebase-debug.log*
firestore-debug.log*
storage-debug.log*
hub-debug.log*
ui-debug.log*

# Python Virtual Environments, Caches & Tooling
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.venv/
**/.venv/
env/
**/env/
venv/
**/venv/
.cache/

# Large Model Weights (source code, configs, manifests and download scripts are preserved)
models/*.onnx
models/*.bin
models/*.pt
models/*.safetensors
models/*.gguf
~/.cache/rembg/

# Runtime Uploads & User Generated Output
storage/uploads/
storage/recordings/
**/storage/originals/*
**/storage/enhanced/*
**/storage/previews/*
!**/storage/originals/.gitkeep
!**/storage/enhanced/.gitkeep
!**/storage/previews/.gitkeep
**/private/uploads/*
!**/private/uploads/.gitkeep

# Local SQLite databases & PID tracking
*.sqlite
*.sqlite3
*.db
.local-pids.json
