# ==============================================================================
# KarigarSaathi Environment Configuration Template
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit actual API keys, secrets, or credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Public Frontend Configuration
# ------------------------------------------------------------------------------
VITE_APP_TITLE=KarigarSaathi
VITE_APP_ENV=development
VITE_DEFAULT_LOCALE=hi
VITE_SUPPORTED_LOCALES=en,hi,bn,te,mr,ta,gu,kn

# ------------------------------------------------------------------------------
# 2. Firebase Web Configuration (Public Client Credentials)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ------------------------------------------------------------------------------
# 3. Backend API Base URL
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=
VITE_API_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# 4. AI & Voice Service Configuration
# ------------------------------------------------------------------------------
VITE_AI_SERVICE_BASE_URL=
VITE_SPEECH_RECOGNITION_LANG=hi-IN

# ------------------------------------------------------------------------------
# 5. Feature Flags & Runtime Switches
# ------------------------------------------------------------------------------
VITE_ENABLE_OFFLINE_SYNC=true
VITE_ENABLE_VOICE_ASSISTANT=true
VITE_ENABLE_COORDINATOR_MODE=true
VITE_ENABLE_MOCK_SERVICES=true
